<Prefab>
  <Window>
    <!-- Botao pequeno "WS:nn%" no canto superior esquerdo da tela do mapa.
         Ajuste MarginLeft/MarginTop para mudar de lugar.
         Se algum Brush nao existir na sua versao, o jogo usa o padrao
         (confira os nomes em GUI/Brushes). -->
    <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            MarginLeft="14" MarginTop="120" IsVisible="@IsVisible">
      <Children>
        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                      SuggestedWidth="120" SuggestedHeight="34"
                      Brush="ButtonBrush1" Command.Click="ExecuteOpen">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Brush="Popup.Button.Text" Text="@Text" />
          </Children>
        </ButtonWidget>
      </Children>
    </Widget>
  </Window>
</Prefab>
