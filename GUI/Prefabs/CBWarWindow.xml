<Prefab>
  <Window>
    <!-- Janela de negociacao estilo CK2.
         Estrutura: titulo | reinos + WarScore | barra -100..+100 |
         fatores | acoes (exigencias, paz branca, rendicao) |
         ofertas do soberano capturado | outra guerra / fechar.
         Tamanhos em pixels (a UI escala com a resolucao). -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            Sprite="BlankWhiteSquare_9" Color="#000000B0">
      <Children>
        <!-- borda dourada -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="784" SuggestedHeight="760"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Sprite="BlankWhiteSquare_9" Color="#C9A24AFF" />
        <!-- painel -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="776" SuggestedHeight="752"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Sprite="BlankWhiteSquare_9" Color="#1A1511FA">
          <Children>
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                       MarginLeft="24" MarginRight="24" MarginTop="18"
                       StackLayout.LayoutMethod="VerticalBottomToTop">
              <Children>

                <!-- TITULO -->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                            SuggestedHeight="40"
                            Brush.FontSize="32" Brush.FontColor="#D4AF37FF"
                            Brush.TextHorizontalAlignment="Center"
                            Brush.TextVerticalAlignment="Center"
                            Text="@Title" />

                <!-- REINOS E WARSCORE -->
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                           SuggestedHeight="96" MarginTop="8"
                           StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <!-- voce -->
                    <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                               SuggestedWidth="220"
                               StackLayout.LayoutMethod="VerticalBottomToTop">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                SuggestedWidth="50" SuggestedHeight="58"
                                HorizontalAlignment="Center"
                                Sprite="BlankWhiteSquare_9" Color="@PlayerColor" />
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                    SuggestedHeight="28"
                                    Brush.FontSize="22" Brush.FontColor="#F4E1C1FF"
                                    Brush.TextHorizontalAlignment="Center"
                                    Text="@PlayerName" />
                      </Children>
                    </ListPanel>
                    <!-- placar -->
                    <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                SuggestedWidth="276"
                                Brush.FontSize="52" Brush.FontColor="#F4E1C1FF"
                                Brush.TextHorizontalAlignment="Center"
                                Brush.TextVerticalAlignment="Center"
                                Text="@ScoreText" />
                    <!-- inimigo -->
                    <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                               SuggestedWidth="220"
                               StackLayout.LayoutMethod="VerticalBottomToTop">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                SuggestedWidth="50" SuggestedHeight="58"
                                HorizontalAlignment="Center"
                                Sprite="BlankWhiteSquare_9" Color="@EnemyColor" />
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                    SuggestedHeight="28"
                                    Brush.FontSize="22" Brush.FontColor="#F4E1C1FF"
                                    Brush.TextHorizontalAlignment="Center"
                                    Text="@EnemyName" />
                      </Children>
                    </ListPanel>
                  </Children>
                </ListPanel>

                <!-- BARRA -100 .. +100 : esquerda vermelha, direita verde -->
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="564" SuggestedHeight="30"
                        HorizontalAlignment="Center" MarginTop="10"
                        Sprite="BlankWhiteSquare_9" Color="#C9A24AFF">
                  <Children>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                            SuggestedWidth="560" SuggestedHeight="26"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Sprite="BlankWhiteSquare_9" Color="#000000CC">
                      <Children>
                        <!-- metade negativa (cresce para a esquerda a partir do centro) -->
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                SuggestedWidth="280" HorizontalAlignment="Left">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="@NegFillWidth" HorizontalAlignment="Right"
                                    Sprite="BlankWhiteSquare_9" Color="#D9534FFF" />
                          </Children>
                        </Widget>
                        <!-- metade positiva (cresce para a direita a partir do centro) -->
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                SuggestedWidth="280" HorizontalAlignment="Right">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="@PosFillWidth" HorizontalAlignment="Left"
                                    Sprite="BlankWhiteSquare_9" Color="#5DBB63FF" />
                          </Children>
                        </Widget>
                        <!-- marca central -->
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                SuggestedWidth="3" HorizontalAlignment="Center"
                                Sprite="BlankWhiteSquare_9" Color="#F4E1C1FF" />
                      </Children>
                    </Widget>
                  </Children>
                </Widget>
                <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                           SuggestedWidth="564" SuggestedHeight="24"
                           HorizontalAlignment="Center"
                           StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                SuggestedWidth="282"
                                Brush.FontSize="18" Brush.FontColor="#D9534FFF"
                                Brush.TextHorizontalAlignment="Left"
                                Text="-100%  derrota" />
                    <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                SuggestedWidth="282"
                                Brush.FontSize="18" Brush.FontColor="#5DBB63FF"
                                Brush.TextHorizontalAlignment="Right"
                                Text="vitoria  +100%" />
                  </Children>
                </ListPanel>

                <!-- FATORES -->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                            SuggestedHeight="26" MarginTop="8"
                            Brush.FontSize="20" Brush.FontColor="#D4AF37FF"
                            Text="Fatores do WarScore" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                            SuggestedHeight="24" MarginLeft="12"
                            Brush.FontSize="20" Brush.FontColor="#F4E1C1FF"
                            Text="@BattlesText" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                            SuggestedHeight="24" MarginLeft="12"
                            Brush.FontSize="20" Brush.FontColor="#F4E1C1FF"
                            Text="@SiegesText" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                            SuggestedHeight="24" MarginLeft="12"
                            Brush.FontSize="20" Brush.FontColor="#F4E1C1FF"
                            Text="@ObjectiveText" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                            SuggestedHeight="24" MarginLeft="12"
                            Brush.FontSize="20" Brush.FontColor="#F4E1C1FF"
                            Text="@PrisonersText" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                            SuggestedHeight="48" MarginLeft="12" MarginTop="4"
                            Brush.FontSize="18" Brush.FontColor="#BFAE8AFF"
                            Text="@StatusText" />

                <!-- ACOES -->
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                           SuggestedHeight="96" MarginTop="8"
                           StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                  SuggestedWidth="232" MarginRight="8"
                                  Brush="ButtonBrush1" IsEnabled="@EnforceEnabled"
                                  Command.Click="ExecuteEnforce">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                   VerticalAlignment="Center" MarginLeft="6" MarginRight="6"
                                   StackLayout.LayoutMethod="VerticalBottomToTop">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                        SuggestedHeight="30"
                                        Brush.FontSize="24" Brush.FontColor="#F4E1C1FF"
                                        Brush.TextHorizontalAlignment="Center"
                                        Text="Forcar exigencias" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                        SuggestedHeight="46"
                                        Brush.FontSize="15" Brush.FontColor="#BFAE8AFF"
                                        Brush.TextHorizontalAlignment="Center"
                                        Text="@EnforceHint" />
                          </Children>
                        </ListPanel>
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                  SuggestedWidth="232" MarginRight="8"
                                  Brush="ButtonBrush1" IsEnabled="@WhiteEnabled"
                                  Command.Click="ExecuteWhitePeace">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                   VerticalAlignment="Center" MarginLeft="6" MarginRight="6"
                                   StackLayout.LayoutMethod="VerticalBottomToTop">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                        SuggestedHeight="30"
                                        Brush.FontSize="24" Brush.FontColor="#F4E1C1FF"
                                        Brush.TextHorizontalAlignment="Center"
                                        Text="Paz branca" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                        SuggestedHeight="46"
                                        Brush.FontSize="15" Brush.FontColor="#BFAE8AFF"
                                        Brush.TextHorizontalAlignment="Center"
                                        Text="@WhiteHint" />
                          </Children>
                        </ListPanel>
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                  SuggestedWidth="232"
                                  Brush="ButtonBrush1" IsEnabled="@SurrenderEnabled"
                                  Command.Click="ExecuteSurrender">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                   VerticalAlignment="Center" MarginLeft="6" MarginRight="6"
                                   StackLayout.LayoutMethod="VerticalBottomToTop">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                        SuggestedHeight="30"
                                        Brush.FontSize="24" Brush.FontColor="#F4E1C1FF"
                                        Brush.TextHorizontalAlignment="Center"
                                        Text="Render-se" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                        SuggestedHeight="46"
                                        Brush.FontSize="15" Brush.FontColor="#BFAE8AFF"
                                        Brush.TextHorizontalAlignment="Center"
                                        Text="@SurrenderHint" />
                          </Children>
                        </ListPanel>
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>

                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                            SuggestedHeight="52" MarginTop="6" MarginLeft="12"
                            Brush.FontSize="16" Brush.FontColor="#BFAE8AFF"
                            Text="@DemandsText" />

                <!-- OFERTAS DO SOBERANO CAPTURADO (so aparece se houver) -->
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                           IsVisible="@HasOffers"
                           StackLayout.LayoutMethod="VerticalBottomToTop">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                SuggestedHeight="26" MarginTop="4"
                                Brush.FontSize="20" Brush.FontColor="#D4AF37FF"
                                Text="Soberano inimigo capturado: voce dita os termos" />
                    <ListPanel DataSource="{Offers}"
                               WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                               StackLayout.LayoutMethod="VerticalBottomToTop">
                      <ItemTemplate>
                        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                      SuggestedHeight="46" MarginTop="3"
                                      Brush="ButtonBrush1" IsEnabled="@IsEnabled"
                                      Command.Click="ExecuteClick">
                          <Children>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       VerticalAlignment="Center" MarginLeft="10" MarginRight="10"
                                       StackLayout.LayoutMethod="VerticalBottomToTop">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                            SuggestedHeight="22"
                                            Brush.FontSize="19" Brush.FontColor="#F4E1C1FF"
                                            Text="@Title" />
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                            SuggestedHeight="20"
                                            Brush.FontSize="14" Brush.FontColor="#BFAE8AFF"
                                            Text="@Detail" />
                              </Children>
                            </ListPanel>
                          </Children>
                        </ButtonWidget>
                      </ItemTemplate>
                    </ListPanel>
                  </Children>
                </ListPanel>

              </Children>
            </ListPanel>

            <!-- RODAPE -->
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                       SuggestedHeight="46" VerticalAlignment="Bottom"
                       MarginLeft="24" MarginRight="24" MarginBottom="14"
                       StackLayout.LayoutMethod="HorizontalLeftToRight">
              <Children>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                              SuggestedWidth="200" Brush="ButtonBrush1"
                              IsVisible="@HasMultipleWars"
                              Command.Click="ExecuteNextWar">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Brush.FontSize="22" Brush.FontColor="#F4E1C1FF"
                                Brush.TextHorizontalAlignment="Center"
                                Brush.TextVerticalAlignment="Center"
                                Text="Outra guerra" />
                  </Children>
                </ButtonWidget>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" />
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                              SuggestedWidth="200" Brush="ButtonBrush1"
                              Command.Click="ExecuteClose">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Brush.FontSize="22" Brush.FontColor="#F4E1C1FF"
                                Brush.TextHorizontalAlignment="Center"
                                Brush.TextVerticalAlignment="Center"
                                Text="Fechar (Esc)" />
                  </Children>
                </ButtonWidget>
              </Children>
            </ListPanel>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
